    "Agent reads the terminal and can run commands after approval. Ask answers without tools and offers to switch when a task needs one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 会读取终端内容，并在获得批准后执行命令。询问模式不使用工具；当任务需要工具时，会建议切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 會讀取終端內容，並在獲得批准後執行命令。詢問模式不使用工具；當任務需要工具時，會建議切換。"
          }
        }
      }
    },
