    "The certificate changed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书已更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證已更改"
          }
        }
      }
    },
    "The hosts and keys currently on this iPhone will be replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上当前的主机和私钥将被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 上當前的主機和私密金鑰將被替換。"
          }
        }
      }
    },
    "The key is stored in the app's private container and only sent to this endpoint.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 App 的私有容器中，只会发送到此端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰儲存在 App 的私有容器中，只會傳送到此端點。"
          }
        }
      }
    },
    "The listener binds 127.0.0.1 on this device and reaches the destination through SSH.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器绑定此设备上的 127.0.0.1，并通过 SSH 到达目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監聽器繫結此裝置上的 127.0.0.1，並透過 SSH 到達目標。"
          }
        }
      }
    },
    "The listener speaks the proxy protocol; the client picks each destination.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器使用代理协议，由客户端选择每个目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監聽器使用代理協議，由用戶端選擇每個目標。"
          }
        }
      }
    },
    "The name identifies the key in the host editor.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称用于在主机编辑器中识别这把密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱用於在主機編輯器中識別這把金鑰。"
          }
        }
      }
    },
    "The provider returned no models.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商没有返回任何模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務供應商沒有返回任何模型。"
          }
        }
      }
    },
    "The remote system has not put any text on its clipboard yet.": {
      "localizations": {
